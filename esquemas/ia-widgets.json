{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vereda.ar/esquemas/v1/ia-widgets.json",
  "title": "Widgets de la IA del comprador",
  "description": "UI generativa del chat del comprador: cada mensaje puede traer widgets tipados que la app dibuja con componentes Vereda. El cliente IGNORA tipos que no conoce y degrada a texto (docs/ia/capacidad.md). Los datos de cada widget (precios, fotos, totales) los pone el nodo desde la base, nunca el modelo. El agente arma carritos; un pedido se confirma solo si la persona lo pidió en su último mensaje y dentro del mandato de quien llama.",
  "$defs": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Versión del contrato de widgets. Un tipo nuevo en una versión mayor no rompe clientes viejos: lo ignoran."
    },
    "widget": {
      "description": "Un widget. Discriminado por 'tipo': si es uno de los conocidos, se valida estricto; si no, cae en 'desconocido' (additionalProperties libre) y el cliente lo saltea.",
      "oneOf": [
        { "$ref": "#/$defs/elegir_categoria" },
        { "$ref": "#/$defs/productos" },
        { "$ref": "#/$defs/producto" },
        { "$ref": "#/$defs/carrito" },
        { "$ref": "#/$defs/checkout" },
        { "$ref": "#/$defs/recomendacion" },
        { "$ref": "#/$defs/comercio" },
        { "$ref": "#/$defs/bienvenida" },
        { "$ref": "#/$defs/respuestas" },
        { "$ref": "#/$defs/mazo" },
        { "$ref": "#/$defs/podio" },
        { "$ref": "#/$defs/promo" },
        { "$ref": "#/$defs/grilla" },
        { "$ref": "#/$defs/comercios" },
        { "$ref": "#/$defs/historial" },
        { "$ref": "#/$defs/pedido_estado" },
        { "$ref": "#/$defs/navegar" },
        { "$ref": "#/$defs/desconocido" }
      ]
    },
    "reputacion_corta": {
      "type": "object",
      "required": ["promedio", "cantidad"],
      "additionalProperties": false,
      "properties": {
        "promedio": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "cantidad": { "type": "integer", "minimum": 0 }
      }
    },
    "variante_corta": {
      "type": "object",
      "required": ["id", "nombre"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string", "maxLength": 80 },
        "precio": { "$ref": "comunes.json#/$defs/monto" }
      }
    },
    "tarjeta_producto": {
      "type": "object",
      "required": ["oferta_id", "nombre", "precio"],
      "additionalProperties": false,
      "properties": {
        "oferta_id": { "type": "string" },
        "comercio_id": { "type": "string" },
        "comercio_nombre": { "type": "string", "maxLength": 120 },
        "nombre": { "type": "string", "maxLength": 120 },
        "descripcion": { "type": "string", "maxLength": 500 },
        "precio": { "$ref": "comunes.json#/$defs/monto" },
        "imagen": { "type": "string", "format": "uri" },
        "unidad": { "type": "string", "maxLength": 40 },
        "agregar": {
          "type": "boolean",
          "default": true,
          "description": "Si true, la app muestra 'Agregar'. Al tocar, la persona llama a los endpoints de carrito; el widget no compra solo."
        },
        "distancia_m": {
          "type": "integer",
          "minimum": 0,
          "description": "Distancia al comercio en metros, desde lat/lng del turno."
        },
        "demora_min": {
          "type": "integer",
          "minimum": 0,
          "description": "Demora típica de entrega o preparación, en minutos."
        },
        "reputacion": {
          "$ref": "#/$defs/reputacion_corta",
          "description": "Promedio y cantidad de reseñas del comercio (o de la oferta si el nodo las tiene)."
        },
        "pedidos_mes": {
          "type": "integer",
          "minimum": 0,
          "description": "Pedidos entregados del mes, agregado anónimo (sin quién)."
        },
        "variante_id": {
          "type": "string",
          "description": "Variante elegida o sugerida de la oferta."
        },
        "variantes": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/variante_corta" }
        },
        "sello": {
          "type": "string",
          "maxLength": 40,
          "description": "Texto corto opcional: 'más pedida', 'cerca', '2x1'."
        },
        "etiqueta": {
          "type": "string",
          "maxLength": 40,
          "description": "Etiqueta corta en bienvenida.promos (ej. '2x1', 'hoy')."
        },
        "precio_antes": {
          "$ref": "comunes.json#/$defs/monto",
          "description": "Precio tachado cuando hay promoción."
        },
        "imagenes": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "format": "uri" },
          "description": "Galería de fotos."
        },
        "video": {
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "poster": { "type": "string", "format": "uri" }
          },
          "description": "Clip vertical corto."
        },
        "abierto": {
          "type": "boolean",
          "description": "El local está abierto ahora."
        }
      }
    },
    "elegir_categoria": {
      "type": "object",
      "required": ["tipo", "version", "opciones"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "elegir_categoria" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "maxLength": 64 },
        "titulo": { "type": "string", "maxLength": 80 },
        "opciones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["id", "etiqueta"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "maxLength": 64 },
              "etiqueta": { "type": "string", "maxLength": 80 },
              "icono": { "type": "string", "maxLength": 40 }
            }
          }
        }
      }
    },
    "productos": {
      "type": "object",
      "required": ["tipo", "version", "items"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "productos" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "maxLength": 64 },
        "titulo": { "type": "string", "maxLength": 80 },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "$ref": "#/$defs/tarjeta_producto" }
        }
      }
    },
    "producto": {
      "type": "object",
      "required": ["tipo", "version"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "producto" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "maxLength": 64 },
        "item": {
          "$ref": "#/$defs/tarjeta_producto",
          "deprecated": true,
          "description": "Nombre viejo de 'tarjeta'; los clientes nuevos leen 'tarjeta'."
        },
        "cantidad": {
          "type": "object",
          "required": ["valor", "unidad"],
          "additionalProperties": false,
          "properties": {
            "valor": { "type": "number" },
            "unidad": { "type": "string" },
            "minimo": { "type": "number" },
            "paso": { "type": "number" },
            "maximo": { "type": "number" }
          }
        },
        "tarjeta": { "$ref": "#/$defs/tarjeta_producto" }
      },
      "anyOf": [{ "required": ["tarjeta"] }, { "required": ["item"] }]
    },
    "carrito": {
      "type": "object",
      "required": ["tipo", "version", "items", "total"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "carrito" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "maxLength": 64 },
        "carrito_id": {
          "type": "string",
          "description": "Id del carrito real del nodo. Con él, confirmar usa los endpoints de siempre."
        },
        "comercio_id": { "type": "string" },
        "comercio_nombre": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["oferta_id", "nombre", "cantidad", "subtotal"],
            "additionalProperties": false,
            "properties": {
              "oferta_id": { "type": "string" },
              "nombre": { "type": "string" },
              "cantidad": {
                "type": "object",
                "required": ["valor", "unidad"],
                "properties": {
                  "valor": { "type": "number" },
                  "unidad": { "type": "string" },
                  "minimo": { "type": "number" },
                  "paso": { "type": "number" },
                  "maximo": { "type": "number" }
                }
              },
              "subtotal": { "$ref": "comunes.json#/$defs/monto" },
              "grupo": {
                "type": "string",
                "maxLength": 80,
                "description": "Plato o grupo al que pertenece el ítem (ej. 'milanesa con puré')."
              },
              "nota": {
                "type": "string",
                "maxLength": 200,
                "description": "Nota corta: '2 platos', 'sin cebolla'."
              },
              "item_id": { "type": "string" },
              "imagen": { "type": "string", "format": "uri" },
              "precio_unitario": { "$ref": "comunes.json#/$defs/monto" },
              "variante": { "type": "string", "maxLength": 80 }
            }
          }
        },
        "faltantes": {
          "type": "array",
          "description": "Ingredientes que el comercio no tiene; el nodo los lista para que la persona decida.",
          "items": {
            "type": "object",
            "required": ["nombre"],
            "additionalProperties": false,
            "properties": {
              "nombre": { "type": "string", "maxLength": 120 },
              "grupo": { "type": "string", "maxLength": 80 }
            }
          }
        },
        "total": { "$ref": "comunes.json#/$defs/monto" },
        "editable": {
          "type": "boolean",
          "description": "La app muestra cantidades editables (acciones cantidad y quitar)."
        }
      }
    },
    "checkout": {
      "type": "object",
      "required": ["tipo", "version", "medios", "total"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "checkout" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "maxLength": 64 },
        "carrito_id": {
          "type": "string",
          "description": "Carrito real del nodo. Confirmar con confirmarCarrito."
        },
        "comercio_id": { "type": "string" },
        "medios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["efectivo", "transferencia"]
          },
          "description": "Solo medios del comercio. Nunca cobro por Vereda. Con efectivo, la app puede pedir paga_con."
        },
        "total": { "$ref": "comunes.json#/$defs/monto" },
        "nota": { "type": "string", "maxLength": 200 },
        "comercio_nombre": { "type": "string" },
        "envio": { "$ref": "comunes.json#/$defs/monto" },
        "entrega": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "modalidad": { "type": "string" },
            "direccion_etiqueta": { "type": "string", "maxLength": 60 },
            "eta": { "type": "string", "format": "date-time" }
          }
        },
        "reparto": {
          "type": "array",
          "description": "Cómo se reparte el total, como en el checkout de la app: cada línea con su concepto y su monto.",
          "items": {
            "type": "object",
            "required": ["concepto", "monto"],
            "additionalProperties": false,
            "properties": {
              "concepto": { "type": "string", "maxLength": 80 },
              "monto": { "$ref": "comunes.json#/$defs/monto" }
            }
          }
        }
      }
    },
    "recomendacion": {
      "type": "object",
      "required": ["tipo", "version", "texto"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "recomendacion" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "maxLength": 64 },
        "texto": { "type": "string", "minLength": 1, "maxLength": 500 },
        "items": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/tarjeta_producto" }
        }
      }
    },
    "comercio": {
      "type": "object",
      "required": ["tipo", "version", "comercio_id", "nombre"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "comercio" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "maxLength": 64 },
        "comercio_id": { "type": "string" },
        "nombre": { "type": "string", "maxLength": 120 },
        "descripcion": { "type": "string", "maxLength": 500 },
        "imagen": { "type": "string", "format": "uri" },
        "abierto": { "type": "boolean" },
        "distancia_m": { "type": "integer", "minimum": 0 },
        "tipo_comercio": {
          "type": "string",
          "description": "Tipo del comercio (supermercado, restaurante, …)."
        }
      }
    },
    "bienvenida": {
      "type": "object",
      "description": "Home del chat vacío. El nodo la arma SIN llamar al modelo (gratis).",
      "required": ["tipo", "version", "titulo"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "bienvenida" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "maxLength": 64 },
        "titulo": {
          "type": "string",
          "maxLength": 120,
          "description": "Ej. '¡Hola, Ana! ¿Qué buscamos hoy?'"
        },
        "subtitulo": { "type": "string", "maxLength": 200 },
        "promos": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/tarjeta_producto" },
          "description": "Promos de adheridos cerca (tarjeta + etiqueta opcional)."
        },
        "volver_a_pedir": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/tarjeta_producto" },
          "description": "De sus pedidos anteriores."
        },
        "sugerencias": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "maxLength": 80 },
          "description": "Chips de arranque: 'Quiero una pizza', 'Compra semanal'."
        }
      }
    },
    "respuestas": {
      "type": "object",
      "description": "Chips sobre el campo de texto. Tocar manda ese texto (o valor) como mensaje.",
      "required": ["tipo", "version", "opciones"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "respuestas" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "maxLength": 64 },
        "opciones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["texto"],
            "additionalProperties": false,
            "properties": {
              "texto": { "type": "string", "maxLength": 80 },
              "valor": {
                "type": "string",
                "maxLength": 80,
                "description": "Si falta, se manda 'texto'."
              }
            }
          }
        },
        "modo": {
          "type": "string",
          "enum": ["respuesta", "filtro"],
          "default": "respuesta"
        }
      }
    },
    "mazo": {
      "type": "object",
      "description": "Cartas apiladas (Paso / ¡Esta! / Más como esta). El agente elige cuándo usarlo.",
      "required": ["tipo", "version", "tarjetas"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "mazo" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "maxLength": 64 },
        "titulo": { "type": "string", "maxLength": 80 },
        "tarjetas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/tarjeta_producto" }
        }
      }
    },
    "podio": {
      "type": "object",
      "description": "Hasta tres recomendadas, en orden, con su razón. Desde una búsqueda, el nodo las ordena con la fórmula pública de docs/ia/capacidad.md.",
      "required": ["tipo", "version", "titulo", "puestos"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "podio" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "maxLength": 64 },
        "titulo": {
          "type": "string",
          "maxLength": 120,
          "description": "Ej. 'Estas no te las podés perder'."
        },
        "puestos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["puesto", "tarjeta", "razon"],
            "additionalProperties": false,
            "properties": {
              "puesto": { "type": "integer", "minimum": 1, "maximum": 3 },
              "tarjeta": { "$ref": "#/$defs/tarjeta_producto" },
              "razon": {
                "type": "string",
                "maxLength": 120,
                "description": "Por qué está en el podio, en castellano. Con la fórmula pública es el término que más vale: 'la más cerca', 'mejor reputación', 'la más pedida del mes', 'la que más pega con lo que pediste'."
              },
              "sello": {
                "type": "string",
                "maxLength": 40,
                "description": "El del lugar en el podio (ej. 'La reina del barrio', 'Plata', 'Bronce'), no una afirmación sobre el producto."
              }
            }
          }
        }
      }
    },
    "promo": {
      "type": "object",
      "description": "Carta grande con sello (ej. girado '2x1').",
      "required": ["tipo", "version", "tarjeta"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "promo" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "maxLength": 64 },
        "tarjeta": { "$ref": "#/$defs/tarjeta_producto" },
        "sello": { "type": "string", "maxLength": 40 }
      }
    },
    "mensaje": {
      "type": "object",
      "required": ["rol"],
      "additionalProperties": false,
      "properties": {
        "rol": {
          "type": "string",
          "enum": ["usuario", "asistente"]
        },
        "texto": { "type": "string", "maxLength": 4000 },
        "widgets": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/widget" }
        }
      }
    },
    "pedido_chat": {
      "type": "object",
      "required": ["lat", "lng"],
      "additionalProperties": false,
      "properties": {
        "mensaje": {
          "type": "string",
          "maxLength": 2000,
          "description": "Lo que escribió la persona. Vacío con historial vacío abre el chat (bienvenida)."
        },
        "historial": {
          "type": "array",
          "maxItems": 40,
          "items": { "$ref": "#/$defs/mensaje" }
        },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "comercio_id": { "type": "string" },
        "carrito_id": { "type": "string" },
        "accion": { "$ref": "#/$defs/accion_chat" }
      },
      "anyOf": [{ "required": ["mensaje"] }, { "required": ["accion"] }]
    },
    "respuesta_chat": {
      "type": "object",
      "required": ["mensaje", "consumo"],
      "additionalProperties": false,
      "properties": {
        "mensaje": { "$ref": "#/$defs/mensaje" },
        "consumo": { "$ref": "ia.json#/$defs/consumo" }
      }
    },
    "desconocido": {
      "type": "object",
      "description": "Widget de un tipo que este nodo/cliente todavía no conoce. Tiene que pasar la validación para que el mensaje no se caiga entero: la app lo saltea y, si hay texto, muestra eso (docs/ia/capacidad.md).",
      "required": ["tipo", "version"],
      "properties": {
        "tipo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "not": {
            "enum": [
              "elegir_categoria",
              "productos",
              "producto",
              "carrito",
              "checkout",
              "recomendacion",
              "comercio",
              "bienvenida",
              "respuestas",
              "mazo",
              "podio",
              "promo",
              "grilla",
              "comercios",
              "historial",
              "pedido_estado",
              "navegar"
            ]
          },
          "description": "Cualquier string que no sea uno de los tipos conocidos."
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Entero ≥ 1. No se fija en 1: un tipo futuro puede traer otra versión."
        }
      },
      "additionalProperties": true
    },
    "tarjeta_comercio": {
      "type": "object",
      "description": "Un local para elegir con los ojos (docs/ia/harness.md §5.2).",
      "required": ["comercio_id", "nombre", "abierto"],
      "additionalProperties": false,
      "properties": {
        "comercio_id": { "type": "string" },
        "nombre": { "type": "string", "maxLength": 120 },
        "rubro": { "type": "string", "maxLength": 80 },
        "portada": { "type": "string", "format": "uri" },
        "galeria": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "format": "uri" }
        },
        "abierto": { "type": "boolean" },
        "distancia_m": { "type": "integer", "minimum": 0 },
        "demora_min": { "type": "integer", "minimum": 0 },
        "reputacion": { "$ref": "#/$defs/reputacion_corta" },
        "envio": { "$ref": "comunes.json#/$defs/monto" },
        "nuevo": { "type": "boolean" },
        "destacados": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/tarjeta_producto" }
        }
      }
    },
    "grilla": {
      "type": "object",
      "description": "Grilla de 2 columnas con fotos para descubrir.",
      "required": ["tipo", "version", "tarjetas"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "grilla" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "maxLength": 64 },
        "titulo": { "type": "string", "maxLength": 80 },
        "tarjetas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/tarjeta_producto" }
        },
        "filtros": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["id", "texto"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "maxLength": 64 },
              "texto": { "type": "string", "maxLength": 40 },
              "activo": { "type": "boolean" }
            }
          }
        },
        "mas": {
          "type": "boolean",
          "description": "Hay más resultados (acción ver_mas)."
        }
      }
    },
    "comercios": {
      "type": "object",
      "description": "Locales para elegir o conocer.",
      "required": ["tipo", "version", "locales"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "comercios" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "maxLength": 64 },
        "titulo": { "type": "string", "maxLength": 80 },
        "locales": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/tarjeta_comercio" }
        }
      }
    },
    "historial": {
      "type": "object",
      "description": "Pedidos anteriores de la persona, para repetir en un toque.",
      "required": ["tipo", "version", "pedidos"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "historial" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "maxLength": 64 },
        "titulo": { "type": "string", "maxLength": 80 },
        "pedidos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["pedido_id", "comercio_nombre", "fecha"],
            "additionalProperties": false,
            "properties": {
              "pedido_id": { "type": "string" },
              "comercio_id": { "type": "string" },
              "comercio_nombre": { "type": "string" },
              "fecha": { "type": "string", "format": "date" },
              "resumen": { "type": "string", "maxLength": 300 },
              "total": { "$ref": "comunes.json#/$defs/monto" },
              "imagenes": {
                "type": "array",
                "maxItems": 3,
                "items": { "type": "string", "format": "uri" }
              },
              "estado": { "type": "string" }
            }
          }
        }
      }
    },
    "pedido_estado": {
      "type": "object",
      "description": "Seguimiento de un pedido; la app lo actualiza con los eventos del nodo.",
      "required": ["tipo", "version", "pedido_id", "estado", "pasos"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "pedido_estado" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "maxLength": 64 },
        "pedido_id": { "type": "string" },
        "comercio_nombre": { "type": "string" },
        "estado": { "type": "string" },
        "pasos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["estado", "etiqueta", "hecho"],
            "additionalProperties": false,
            "properties": {
              "estado": { "type": "string" },
              "etiqueta": { "type": "string", "maxLength": 80 },
              "hecho": { "type": "boolean" },
              "instante": { "type": "string", "format": "date-time" }
            }
          }
        },
        "eta": { "type": "string", "format": "date-time" },
        "repartidor": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "nombre": { "type": "string" } }
        }
      }
    },
    "navegar": {
      "type": "object",
      "description": "Lleva a una pantalla de la app.",
      "required": ["tipo", "version", "destino", "texto"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "navegar" },
        "version": { "$ref": "#/$defs/version" },
        "id": { "type": "string", "maxLength": 64 },
        "destino": {
          "type": "object",
          "required": ["pantalla"],
          "additionalProperties": false,
          "properties": {
            "pantalla": {
              "type": "string",
              "enum": [
                "comercio",
                "producto",
                "carrito",
                "pedido",
                "tu_ia",
                "direcciones"
              ]
            },
            "id": { "type": "string" }
          }
        },
        "texto": { "type": "string", "maxLength": 60 },
        "auto": { "type": "boolean", "default": false }
      }
    },
    "accion_chat": {
      "type": "object",
      "description": "Un toque sobre un widget (docs/ia/harness.md §5.4).",
      "required": ["tipo"],
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "type": "string",
          "enum": [
            "elegir",
            "agregar",
            "cantidad",
            "quitar",
            "ir_a_pagar",
            "repetir",
            "ver_producto",
            "ver_carta",
            "elegir_comercio",
            "confirmado",
            "responder",
            "filtro",
            "mas_como_esta",
            "ver_mas"
          ]
        },
        "widget_id": { "type": "string", "maxLength": 64 },
        "oferta_id": { "type": "string" },
        "variante_id": { "type": "string" },
        "cantidad": { "type": "number", "exclusiveMinimum": 0 },
        "carrito_id": { "type": "string" },
        "item_id": { "type": "string" },
        "pedido_id": { "type": "string" },
        "comercio_id": { "type": "string" },
        "filtro_id": { "type": "string", "maxLength": 64 },
        "activo": { "type": "boolean" },
        "texto": { "type": "string", "maxLength": 2000 },
        "valor": {
          "description": "Número en 'cantidad'; texto en 'responder'.",
          "type": ["number", "string"]
        }
      }
    },
    "evento_accion": {
      "type": "object",
      "description": "Evento 'accion' del stream: un paso del agente, para el estado cargando (§5.5).",
      "required": ["tool", "etiqueta", "estado"],
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string" },
        "etiqueta": { "type": "string", "maxLength": 80 },
        "estado": { "type": "string", "enum": ["inicio", "fin"] }
      }
    }
  }
}
