{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vereda.ar/esquemas/v1/mandato.json",
  "title": "Mandato a un agente",
  "description": "Qué puede hacer un agente en nombre de una persona. Firmado por la persona; la red lo aplica en cada llamada. Revocable en un toque. Cada acción del agente queda en el historial con via: agente.",
  "type": "object",
  "allOf": [{ "$ref": "comunes.json#/$defs/metadatos" }],
  "required": ["otorgante", "agente", "scopes", "estado", "firma"],
  "properties": {
    "otorgante": { "$ref": "comunes.json#/$defs/identidad" },
    "agente": {
      "type": "object",
      "required": ["id", "nombre"],
      "properties": {
        "id": { "type": "string", "description": "Identificador del cliente OAuth del agente." },
        "nombre": { "type": "string", "description": "Como lo ve la persona: 'Claude', 'Mi asistente de compras'." },
        "clave_publica": { "type": "string" }
      }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(leer|armar|hablar|suscribir|pedir:[0-9]+|pedir_diario:[0-9]+|comercios:[a-z0-9._@,-]+)$" },
      "description": "leer, armar, hablar, suscribir, pedir:<centavos por pedido>, pedir_diario:<centavos por día>, comercios:<lista de identidades>."
    },
    "confirmar_siempre": {
      "type": "array",
      "items": { "type": "string", "enum": ["primer_pedido_a_comercio_nuevo", "toda_suscripcion", "todo_pedido", "pedidos_con_alcohol", "sobre_tope"] },
      "default": ["primer_pedido_a_comercio_nuevo", "toda_suscripcion", "sobre_tope"]
    },
    "vence": { "$ref": "comunes.json#/$defs/instante" },
    "estado": { "type": "string", "enum": ["activo", "revocado", "vencido"] },
    "revocado_en": { "$ref": "comunes.json#/$defs/instante" },
    "firma": { "$ref": "comunes.json#/$defs/firma" }
  }
}
