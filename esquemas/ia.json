{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vereda.ar/esquemas/v1/ia.json",
  "title": "IA del nodo",
  "description": "Capacidad opcional de IA nativa: anuncio en /.well-known/vereda.json, activación por identidad, borradores que proponen y no escriben, consumo auditable y extracto mensual (docs/ia/capacidad.md).",
  "$defs": {
    "capacidad": {
      "type": "object",
      "description": "Presente solo si el nodo ofrece IA. Ausente: /ia/* responde 501 no_implementado y las apps no muestran nada.",
      "required": ["funciones", "precio", "pago", "tope_mensual_usd", "periodo_reseteo"],
      "additionalProperties": false,
      "properties": {
        "funciones": { "$ref": "#/$defs/funciones" },
        "precio": { "$ref": "#/$defs/precio" },
        "pago": { "$ref": "#/$defs/pago" },
        "tope_mensual_usd": { "$ref": "#/$defs/tope_mensual" },
        "periodo_reseteo": { "type": "string", "const": "mensual", "description": "El consumido vuelve a 0 el día 1 del mes, en la zona horaria del nodo." },
        "exige_pago_previo": { "type": "boolean", "default": false, "description": "Si true, sin el extracto del mes anterior marcado recibido la IA queda pausada al empezar el mes." }
      }
    },
    "funciones": {
      "type": "object",
      "description": "Qué funciones ofrece este nodo. Ausente un grupo o una clave = esa función no se ofrece.",
      "additionalProperties": false,
      "properties": {
        "comercio": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": { "type": "string", "enum": ["catalogo_desde_fotos", "sugerir_producto", "borrador_respuesta", "resumen_dia"] }
        },
        "comprador": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": { "type": "string", "enum": ["pedido_propuesto", "buscar", "sugerir"] }
        }
      }
    },
    "precio": {
      "type": "object",
      "required": ["modalidad", "margen", "moneda"],
      "additionalProperties": false,
      "properties": {
        "modalidad": { "type": "string", "const": "costo", "description": "Se cobra el costo real del gateway, sin markup." },
        "margen": { "type": "number", "const": 0 },
        "moneda": { "type": "string", "const": "USD" },
        "equivalente_ars": { "type": "string", "maxLength": 80, "description": "Texto de referencia para la UI ('al tipo del día', no un tipo de cambio fijo del protocolo)." }
      }
    },
    "pago": {
      "type": "object",
      "required": ["destino", "referencia"],
      "additionalProperties": false,
      "properties": {
        "destino": { "type": "string", "const": "sostenimiento.cuenta", "description": "La plata va a la cuenta pública del operador (docs/sostenimiento.md). Vereda nunca intermedia." },
        "referencia": { "type": "string", "const": "ia:<identidad>:<periodo>", "description": "Patrón del concepto al transferir. periodo es AAAA-MM." }
      }
    },
    "tope_mensual": {
      "type": "object",
      "required": ["default_usd", "maximo_usd"],
      "additionalProperties": false,
      "properties": {
        "default_usd": { "type": "number", "exclusiveMinimum": 0, "description": "Tope que propone el nodo al activar, en USD." },
        "maximo_usd": { "type": "number", "exclusiveMinimum": 0, "description": "Tope más alto que una identidad puede elegir. Tiene que ser >= default_usd." }
      }
    },
    "consumo": {
      "type": "object",
      "description": "Cuánto costó una generación. Va en toda respuesta exitosa de una función.",
      "required": ["tokens_entrada", "tokens_salida", "costo_usd", "generacion"],
      "additionalProperties": false,
      "properties": {
        "tokens_entrada": { "type": "integer", "minimum": 0 },
        "tokens_salida": { "type": "integer", "minimum": 0 },
        "costo_usd": { "type": "number", "minimum": 0, "description": "Costo real del gateway en USD, sin margen." },
        "generacion": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Id opaco de esta llamada; aparece en el extracto." }
      }
    },
    "mi_ia": {
      "type": "object",
      "description": "Estado de la IA de la identidad autenticada (GET /ia/yo).",
      "required": ["estado", "periodo", "consumido"],
      "additionalProperties": false,
      "properties": {
        "estado": { "type": "string", "enum": ["inactiva", "activa", "pausada"] },
        "activa_hasta": { "$ref": "comunes.json#/$defs/instante", "description": "Hasta cuándo queda activa si el nodo o la persona fijaron un fin. Ausente: sin fecha de corte." },
        "tope_usd": { "type": "number", "exclusiveMinimum": 0, "description": "Tope del mes en USD. Ausente si estado es inactiva." },
        "consumido": { "$ref": "#/$defs/consumido_periodo" },
        "periodo": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$", "description": "Período abierto, AAAA-MM, zona del nodo." },
        "pago_previo_pendiente": { "type": "boolean", "description": "true si exige_pago_previo y el mes anterior no está marcado recibido: la IA no puede pasar a activa." }
      }
    },
    "consumido_periodo": {
      "type": "object",
      "required": ["usd", "tokens_entrada", "tokens_salida", "generaciones"],
      "additionalProperties": false,
      "properties": {
        "usd": { "type": "number", "minimum": 0 },
        "tokens_entrada": { "type": "integer", "minimum": 0 },
        "tokens_salida": { "type": "integer", "minimum": 0 },
        "generaciones": { "type": "integer", "minimum": 0 }
      }
    },
    "configurar": {
      "type": "object",
      "required": ["estado"],
      "additionalProperties": false,
      "properties": {
        "estado": { "type": "string", "enum": ["activa", "pausada", "inactiva"], "description": "inactiva apaga y deja de consumir; no borra el extracto." },
        "tope_usd": { "type": "number", "exclusiveMinimum": 0, "description": "Obligatorio al pasar a activa la primera vez; entre default y maximo del nodo. Al pausar o reactivar puede omitirse: queda el anterior." }
      }
    },
    "declarar_transferencia": {
      "type": "object",
      "required": ["periodo"],
      "additionalProperties": false,
      "properties": {
        "periodo": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
        "comprobante": { "type": "string", "maxLength": 500, "description": "Número de operación o nota corta. El nodo no guarda archivos." }
      }
    },
    "extracto": {
      "type": "object",
      "required": ["periodo", "lineas", "total", "pago"],
      "additionalProperties": false,
      "properties": {
        "periodo": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
        "lineas": {
          "type": "array",
          "description": "Una por generación, de la más nueva a la más vieja.",
          "items": { "$ref": "#/$defs/linea_extracto" }
        },
        "total": { "$ref": "#/$defs/consumido_periodo" },
        "pago": {
          "type": "object",
          "required": ["referencia", "estado"],
          "additionalProperties": false,
          "properties": {
            "referencia": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Ej: ia:marta@vereda.ar:2026-09" },
            "estado": { "type": "string", "enum": ["sin_cargo", "pendiente", "declarado", "recibido"], "description": "sin_cargo si total.usd es 0; pendiente hasta que la persona declara; declarado cuando POST /ia/yo/transferencia; recibido cuando el operador lo marca." },
            "cuenta": {
              "type": "object",
              "description": "Copia de sostenimiento.cuenta para transferir sin ir a buscarla.",
              "required": ["alias", "titular"],
              "additionalProperties": false,
              "properties": {
                "alias": { "type": "string" },
                "titular": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "linea_extracto": {
      "type": "object",
      "required": ["generacion", "funcion", "instante", "tokens_entrada", "tokens_salida", "costo_usd"],
      "additionalProperties": false,
      "properties": {
        "generacion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "funcion": { "type": "string", "enum": ["catalogo_desde_fotos", "sugerir_producto", "borrador_respuesta", "resumen_dia", "pedido_propuesto", "buscar", "sugerir"] },
        "instante": { "$ref": "comunes.json#/$defs/instante" },
        "tokens_entrada": { "type": "integer", "minimum": 0 },
        "tokens_salida": { "type": "integer", "minimum": 0 },
        "costo_usd": { "type": "number", "minimum": 0 }
      }
    },
    "respuesta_funcion": {
      "type": "object",
      "description": "Envoltorio común: la propuesta (borrador) más el consumo. Cada función concreta agrega 'propuesta' con su forma.",
      "required": ["propuesta", "consumo"],
      "properties": {
        "propuesta": { "type": "object", "description": "El borrador. Confirmarlo es otro paso, con los endpoints de siempre." },
        "consumo": { "$ref": "#/$defs/consumo" }
      }
    },
    "item_catalogo_propuesto": {
      "type": "object",
      "required": ["nombre"],
      "additionalProperties": false,
      "properties": {
        "nombre": { "type": "string", "minLength": 1, "maxLength": 120 },
        "descripcion": { "type": "string", "maxLength": 2000 },
        "precio_sugerido": { "$ref": "comunes.json#/$defs/monto" },
        "unidad": { "type": "string", "maxLength": 40 },
        "atributos": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 120 } },
        "imagen": { "type": "string", "format": "uri", "description": "URL de la foto de la que salió, si aplica." }
      }
    },
    "propuesta_catalogo": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/item_catalogo_propuesto" } }
      }
    },
    "propuesta_producto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nombre": { "type": "string", "maxLength": 120 },
        "descripcion": { "type": "string", "maxLength": 2000 },
        "precio_sugerido": { "$ref": "comunes.json#/$defs/monto" }
      }
    },
    "propuesta_borrador_respuesta": {
      "type": "object",
      "required": ["texto"],
      "additionalProperties": false,
      "properties": {
        "texto": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "tono": { "type": "string", "enum": ["cercano", "formal", "breve"], "description": "Cómo se pidió; el nodo puede ignorarlo." }
      }
    },
    "propuesta_resumen_dia": {
      "type": "object",
      "required": ["resumen", "reponer"],
      "additionalProperties": false,
      "properties": {
        "resumen": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "reponer": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["nombre"],
            "additionalProperties": false,
            "properties": {
              "nombre": { "type": "string" },
              "oferta_id": { "type": "string" },
              "motivo": { "type": "string", "maxLength": 200 }
            }
          }
        },
        "numeros": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pedidos": { "type": "integer", "minimum": 0 },
            "vendido": { "$ref": "comunes.json#/$defs/monto" }
          }
        }
      }
    },
    "propuesta_pedido": {
      "type": "object",
      "required": ["comercio_id", "items", "interpretacion"],
      "additionalProperties": false,
      "properties": {
        "comercio_id": { "type": "string" },
        "comercio_nombre": { "type": "string" },
        "interpretacion": { "type": "string", "minLength": 1, "maxLength": 500, "description": "Cómo entendió el pedido, para que la persona lo revise." },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["oferta_id", "cantidad"],
            "additionalProperties": false,
            "properties": {
              "oferta_id": { "type": "string" },
              "nombre": { "type": "string" },
              "cantidad": { "type": "object", "required": ["valor", "unidad"], "properties": { "valor": { "type": "number" }, "unidad": { "type": "string" } } }
            }
          }
        }
      }
    },
    "propuesta_buscar": {
      "type": "object",
      "required": ["interpretacion", "resultados"],
      "additionalProperties": false,
      "properties": {
        "interpretacion": { "type": "string", "minLength": 1, "maxLength": 500 },
        "resultados": { "type": "array", "description": "Misma forma que los ítems de GET /buscar." }
      }
    },
    "propuesta_sugerir": {
      "type": "object",
      "required": ["tipo", "items"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "type": "string", "enum": ["repetir", "sugerir"] },
        "pedido_id": { "type": "string", "description": "Si tipo es repetir: el pedido de origen." },
        "interpretacion": { "type": "string", "maxLength": 500 },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["oferta_id"],
            "additionalProperties": false,
            "properties": {
              "oferta_id": { "type": "string" },
              "nombre": { "type": "string" },
              "comercio_id": { "type": "string" },
              "motivo": { "type": "string", "maxLength": 200 }
            }
          }
        }
      }
    },
    "pedido_catalogo_fotos": {
      "type": "object",
      "required": ["fotos"],
      "additionalProperties": false,
      "properties": {
        "fotos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string", "format": "uri" },
          "description": "URLs de fotos (p. ej. las que devolvió POST /medios). El nodo las baja o se las pasa al gateway."
        },
        "indicaciones": { "type": "string", "maxLength": 1000 }
      }
    },
    "pedido_sugerir_producto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nombre": { "type": "string", "maxLength": 120 },
        "descripcion": { "type": "string", "maxLength": 2000 },
        "foto": { "type": "string", "format": "uri" },
        "oferta_id": { "type": "string", "description": "Si ya existe, para reescribir descripción/precio." },
        "indicaciones": { "type": "string", "maxLength": 1000 }
      }
    },
    "pedido_borrador_respuesta": {
      "type": "object",
      "required": ["sobre"],
      "additionalProperties": false,
      "properties": {
        "sobre": {
          "type": "object",
          "required": ["tipo", "id"],
          "additionalProperties": false,
          "properties": {
            "tipo": { "type": "string", "enum": ["mensaje", "resena"] },
            "id": { "type": "string" }
          }
        },
        "tono": { "type": "string", "enum": ["cercano", "formal", "breve"] },
        "indicaciones": { "type": "string", "maxLength": 1000 }
      }
    },
    "pedido_resumen_dia": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dia": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Default: hoy en la zona del nodo." },
        "indicaciones": { "type": "string", "maxLength": 1000 }
      }
    },
    "pedido_pedido_propuesto": {
      "type": "object",
      "required": ["pedido", "lat", "lng"],
      "additionalProperties": false,
      "properties": {
        "pedido": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "Lenguaje natural: 'armame una picada para 6'." },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "comercio_id": { "type": "string", "description": "Si la persona ya eligió el local." }
      }
    },
    "pedido_buscar": {
      "type": "object",
      "required": ["q", "lat", "lng"],
      "additionalProperties": false,
      "properties": {
        "q": { "type": "string", "minLength": 1, "maxLength": 500 },
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      }
    },
    "pedido_sugerir": {
      "type": "object",
      "required": ["tipo"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "type": "string", "enum": ["repetir", "sugerir"] },
        "pedido_id": { "type": "string", "description": "Obligatorio con tipo repetir." },
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      }
    }
  }
}
