{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vereda.ar/esquemas/v1/carrito.json",
  "title": "Carrito",
  "description": "Pedido en armado, a un solo comercio. Se valida paso a paso y dice qué falta. No retiene stock ni cupos: la reserva ocurre al confirmar (ver docs/carrito-y-reserva.md). Vive en el nodo del usuario; no se federa.",
  "type": "object",
  "required": ["id", "estado", "items", "vence"],
  "properties": {
    "id": { "type": "string" },
    "estado": { "type": "string", "enum": ["valido", "incompleto", "no_disponible"], "description": "'no_disponible': algún ítem, cupo o franja dejó de estar disponible desde que se agregó." },
    "faltantes": { "type": "array", "items": { "type": "object", "properties": { "item_id": { "type": "string" }, "grupo_id": { "type": "string" }, "mensaje": { "type": "string" }, "opciones": { "type": "array", "items": { "type": "string" } } } } },
    "items": { "type": "array", "items": { "$ref": "pedido.json#/$defs/item" } },
    "modalidad": { "$ref": "pedido.json#/properties/modalidad" },
    "modalidades_disponibles": { "type": "array", "items": { "$ref": "modalidad.json" } },
    "totales": { "$ref": "pedido.json#/properties/totales" },
    "reparto": { "$ref": "pedido.json#/properties/reparto" },
    "eta": { "$ref": "comunes.json#/$defs/instante" },
    "descuentos_aplicados": { "type": "array", "items": { "$ref": "pedido.json#/$defs/descuento_aplicado" } },
    "puntos_a_canjear": { "type": "integer", "minimum": 0 },
    "sugerencias": { "type": "array", "description": "Promociones a un paso, en texto que se le puede repetir a la persona.", "items": { "type": "object", "required": ["promocion_id", "mensaje"], "properties": { "promocion_id": { "$ref": "comunes.json#/$defs/id" }, "mensaje": { "type": "string", "description": "'Te faltan $2.000 para 10 % de descuento', 'Llevando una más, la tercera es gratis'." } } } },
    "dentro_del_mandato": { "type": "boolean" },
    "vence": { "$ref": "comunes.json#/$defs/instante", "description": "24 h después de la última modificación. Es solo limpieza: un carrito vencido no libera nada porque no retenía nada." }
  },
  "$defs": {
    "item_entrada": {
      "type": "object",
      "description": "Lo que el cliente manda a POST /carritos/{id}/items. El nodo completa nombre, precio_unitario y estado desde la oferta; no los acepta del cliente.",
      "required": ["oferta_id", "cantidad"],
      "additionalProperties": false,
      "properties": {
        "oferta_id": { "$ref": "comunes.json#/$defs/id" },
        "variante_id": { "type": "string" },
        "cantidad": { "$ref": "comunes.json#/$defs/cantidad" },
        "opciones": {
          "type": "array",
          "items": { "type": "object", "required": ["grupo_id", "opcion_id"], "properties": { "grupo_id": { "type": "string" }, "opcion_id": { "type": "string" } } }
        },
        "modificador_libre": { "type": "string", "maxLength": 200 },
        "preferencia_sustitucion": { "type": "string", "enum": ["similar_ok", "misma_marca", "preguntar", "quitar"], "default": "preguntar" },
        "para": { "$ref": "comunes.json#/$defs/identidad", "description": "En pedidos grupales: a quién pertenece el ítem." }
      }
    }
  }
}
