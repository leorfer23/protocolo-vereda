{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vereda.ar/esquemas/v1/error.json",
  "title": "Error",
  "description": "Formato único de error (RFC 9457 Problem Details). El campo 'mensaje' es una frase completa en español que un agente puede citar a la persona.",
  "type": "object",
  "required": ["codigo", "mensaje", "estado_http"],
  "properties": {
    "codigo": { "type": "string", "pattern": "^[a-z_]+$", "description": "Sin enum cerrado a propósito: un nodo puede necesitar códigos propios. Los de 'examples' son el vocabulario común, de negocio y de transporte, para que un agente pueda ramificar por los casos más frecuentes sin adivinar cómo los nombra cada nodo.", "examples": ["oferta_no_disponible", "fuera_de_zona", "comercio_cerrado", "falta_opcion", "fuera_de_mandato", "no_es_el_dueno", "sin_permiso", "invitacion_invalida", "ya_es_miembro", "requiere_confirmacion", "cupo_agotado", "carrito_vencido", "fuera_de_ventana_resena", "codigo_retiro_invalido", "efectivo_no_disponible", "medio_no_disponible", "tipo_no_admitido", "medio_muy_grande", "tope_de_medios_alcanzado", "no_es_el_destinatario", "repartidor_no_acepta", "firma_invalida", "firma_requerida", "rendicion_no_aplica", "rendicion_antes_de_tiempo", "rendicion_sin_declarar", "rendicion_confirmada", "clave_desconocida", "clave_comprometida", "clave_rotada", "vinculacion_no_soportada", "prueba_invalida", "atestacion_repetida", "sin_pedidos_suficientes", "codigo_de_contacto_invalido", "denuncia_repetida", "prueba_no_admitida", "reclamo_abierto", "secuencia_fuera_de_orden", "nodo_no_disponible", "version_no_soportada", "no_autenticado", "no_encontrado", "metodo_no_permitido", "cuerpo_invalido", "parametro_invalido", "documento_invalido", "no_implementado", "error_interno"] },
    "mensaje": { "type": "string", "examples": ["Ese comercio no entrega en tu zona después de las 22."] },
    "estado_http": { "type": "integer" },
    "detalle": { "type": "object", "description": "Datos estructurados para el cliente: qué opción falta, hasta qué monto alcanza el mandato, link de confirmación." },
    "faltantes": { "type": "array", "items": { "type": "object", "properties": { "campo": { "type": "string" }, "grupo_id": { "type": "string" }, "opciones": { "type": "array", "items": { "type": "string" } } } } },
    "confirmacion": { "type": "object", "properties": { "url": { "type": "string", "format": "uri" }, "codigo": { "type": "string" }, "vence": { "$ref": "comunes.json#/$defs/instante" } } },
    "instancia": { "type": "string", "format": "uri" }
  }
}
